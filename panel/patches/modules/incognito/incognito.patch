--- /dev/null
+++ b/tools/ui/src/lib/stores/incognito-chat.svelte.ts
@@ -0,0 +1,145 @@
+/**
+ * incognitoChatStore - chats that are never written to disk.
+ *
+ * An incognito chat is a conversation the app would normally persist, except
+ * that every write for it is intercepted here and kept in memory instead: no
+ * conversation row, no messages, nothing in the sidebar after a reload, no
+ * stream-resume state in localStorage. It lives exactly as long as the tab.
+ *
+ * The interception lives in DatabaseService (the single choke point every
+ * write goes through), not in the chat flow, so the rest of the app is unaware:
+ * callers still get a conversation back, still get messages back from
+ * getConversationMessages, still get their updates "accepted" - the objects
+ * simply never reach IndexedDB.
+ *
+ * Panel/frontend code drives it (see panel/frontend/chat-permission and the
+ * `/incognito` command): requestNext() marks that the next conversation to be
+ * created is incognito.
+ *
+ * Deliberately dependency-free: DatabaseService imports this module, and it is
+ * the lowest layer of the app, so this must not import services or stores back.
+ * It touches nothing but the types.
+ */
+
+import { SvelteSet } from 'svelte/reactivity';
+
+interface IncognitoConversation {
+	conversation: DatabaseConversation;
+	messages: DatabaseMessage[];
+}
+
+class IncognitoChatStore {
+	/** Conversation ids that must never reach IndexedDB (reactive: the UI badges them). */
+	incognitoConversationIds = $state(new SvelteSet<string>());
+
+	/** Messages belonging to incognito conversations, so id-keyed writes are caught too. */
+	messageIds = new SvelteSet<string>();
+
+	/** True once the user asked for the next chat to be incognito. */
+	pending = $state(false);
+
+	private store = new Map<string, IncognitoConversation>();
+
+	/** The next conversation created will be incognito. */
+	requestNext(): void {
+		this.pending = true;
+	}
+
+	/** Called when the user opens some other chat, so a stale request cannot leak onto it. */
+	cancelPending(): void {
+		this.pending = false;
+	}
+
+	consumePending(): boolean {
+		const wasPending = this.pending;
+
+		this.pending = false;
+
+		return wasPending;
+	}
+
+	isIncognitoConversation(convId?: string | null): boolean {
+		return !!convId && this.incognitoConversationIds.has(convId);
+	}
+
+	isIncognitoMessage(messageId?: string | null): boolean {
+		return !!messageId && this.messageIds.has(messageId);
+	}
+
+	get activeCount(): number {
+		return this.incognitoConversationIds.size;
+	}
+
+	// --- stand-ins for what the database would have held --------------------
+
+	createConversation(conversation: DatabaseConversation): DatabaseConversation {
+		this.incognitoConversationIds.add(conversation.id);
+		this.store.set(conversation.id, { conversation, messages: [] });
+
+		return conversation;
+	}
+
+	/** Remember a message (and its id) that must never be written. */
+	trackMessage(convId: string, message: DatabaseMessage): DatabaseMessage {
+		const entry = this.store.get(convId);
+
+		if (entry) entry.messages.push(message);
+
+		this.messageIds.add(message.id);
+
+		return message;
+	}
+
+	getConversation(convId: string): DatabaseConversation | undefined {
+		return this.store.get(convId)?.conversation;
+	}
+
+	getMessages(convId: string): DatabaseMessage[] {
+		return this.store.get(convId)?.messages ?? [];
+	}
+
+	listConversations(): DatabaseConversation[] {
+		return [...this.store.values()].map((entry) => entry.conversation);
+	}
+
+	/** Apply a patch in memory (updateMessage / updateConversation / updateCurrentNode). */
+	patchMessage(messageId: string, updates: Partial<Omit<DatabaseMessage, 'id'>>): void {
+		for (const entry of this.store.values()) {
+			const index = entry.messages.findIndex((m) => m.id === messageId);
+
+			if (index !== -1) {
+				entry.messages[index] = { ...entry.messages[index], ...updates };
+
+				return;
+			}
+		}
+	}
+
+	patchConversation(convId: string, updates: Partial<DatabaseConversation>): void {
+		const entry = this.store.get(convId);
+
+		if (entry) entry.conversation = { ...entry.conversation, ...updates };
+	}
+
+	removeMessage(messageId: string): void {
+		this.messageIds.delete(messageId);
+
+		for (const entry of this.store.values()) {
+			entry.messages = entry.messages.filter((m) => m.id !== messageId);
+		}
+	}
+
+	/** Drop a whole conversation - what "close incognito" does. */
+	remove(convId: string): void {
+		const entry = this.store.get(convId);
+
+		if (entry) {
+			for (const message of entry.messages) this.messageIds.delete(message.id);
+		}
+
+		this.store.delete(convId);
+		this.incognitoConversationIds.delete(convId);
+	}
+}
+
+export const incognitoChatStore = new IncognitoChatStore();
