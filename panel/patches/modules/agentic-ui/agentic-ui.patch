new file mode 100644
index 0000000000..3f7e451998
--- /dev/null
+++ b/tools/ui/src/lib/utils/compaction-tool-distill.ts
@@ -0,0 +1,188 @@
+/**
+ * Tool-result distillation for compaction (LLMLingua-style, heuristic tier).
+ *
+ * Why: compactConversation builds its transcript from USER + ASSISTANT turns
+ * only, so the model never re-sees facts it itself surfaced through tools —
+ * file paths, commands, error messages, service state. On this user's
+ * conversations tool results are 87% of transcript bytes, and the residue
+ * that turned out to matter after compaction was precisely those facts.
+ *
+ * What this module does: a deterministic, offline (no extra model calls)
+ * reduction of one tool result to its load-bearing lines —
+ *   - error/tail lines (they are usually the *finding*),
+ *   - paths and command lines,
+ *   - enough head for context,
+ *   - de-duplicated and binary noise dropped,
+ * every rule chosen because compaction asking for "every fact" is exactly
+ * what a summarizer cannot recover once the raw dump is gone.
+ *
+ * Deliberately NOT a small-model compressor (that is LLMLingua's learnable
+ * tier): keep it regex-grade so the same output is reproducible in a test
+ * environment, explainable in a diff, and free.
+ */
+
+/** Hard cap per tool message, applied after selection. */
+export const TOOL_DISTILL_MAX_CHARS = 2000;
+
+/** How many head lines survive verbatim (context for where the tool was). */
+export const HEAD_LINES = 10;
+
+/** How many tail lines survive verbatim (where findings usually live). */
+export const TAIL_LINES = 14;
+
+/** Lines worth keeping from the middle, matched case-insensitively. */
+const MIDDLE_KEEP_RE =
+	/(error|failed|failure|rejected|denied|forbidden|exception|traceback|fatal|invalid|timed? ?out|refused|exceeded|not found|unavailable|retrying|active|inactive|running|loaded|unloaded|exit code|status:)/i;
+
+/** Path-ish or command-ish tokens to keep from the middle. */
+const PATH_RE = /(\/[\w@%\-+.\\/]{3,}|~\/[\w\-+.\\/]+|\.{1,2}\/[\w\-+.\\/]+)/;
+const CMD_RE = /(^\s*[\$#]?\s*(sudo |systemctl |journalctl |curl |git |python3? |npm |node |llama-|make |pip |find |grep )\b|\b(\.\/|bash|sh|zsh)\b)/i;
+
+/** A JSON/script code fence or payload start. Keep structured data heads. */
+const STRUCTURED_RE = /^(\s*[\{\[<]|=== |\-\-\- |#!)/;
+
+/**
+ * Ratio of non-printable characters above which we call a line binary noise
+ * (ELF dumps, base64 blobs, minified data). Those lines destroy summary
+ * quality: they tokenize densely and carry nothing factual that survives.
+ */
+function isBinaryNoise(line: string): boolean {
+	if (line.length === 0) return false;
+	let weird = 0;
+	for (let i = 0; i < line.length; i++) {
+		const c = line.charCodeAt(i);
+		if (c < 9 || (c > 13 && c < 32) || c > 0xff) weird++;
+	}
+	return weird / line.length > 0.12;
+}
+
+function looksLikeBase64(line: string): boolean {
+	if (line.length < 40) return false;
+	const cut = line.replace(/[\s"']/g, '');
+	if (!cut.length) return false;
+	return /^[A-Za-z0-9+/=._-]*$/.test(cut) && !/[ ]{2}/.test(line) && !/%|^#!/.test(line) &&
+		// a long token without a single space is data, not prose; prose errs on the side of short words
+		cut.split(/[A-Za-z]/).length > cut.length * 0.9;
+}
+
+/** Collapse runs of identical lines into one marker line. */
+function dedupeLines(lines: string[]): string[] {
+	const out: string[] = [];
+	let i = 0;
+	while (i < lines.length) {
+		let j = i;
+		while (j + 1 < lines.length && lines[j + 1] === lines[i]) j++;
+		const run = j - i + 1;
+		out.push(run > 3 ? `${lines[i]} [repeated x${run}]` : lines[i]);
+		i = j + 1;
+	}
+	return out;
+}
+
+/**
+ * Reduce one tool result to its load-bearing lines.
+ *
+ * @param content raw tool-result text
+ * @param maxChars budget for the returned string (default TOOL_DISTILL_MAX_CHARS)
+ * @returns distilled text, never empty ( '[no output]' ) and always <= maxChars,
+ *          with a trailing accounting line so a human can audit what was kept.
+ */
+export function distillToolResult(content: string, maxChars: number = TOOL_DISTILL_MAX_CHARS): string {
+	const raw = content ?? '';
+	if (!raw || !raw.trim()) return '[tool produced no output]';
+
+	const lines = raw.replace(/\r\n/g, '\n').split('\n');
+	const clean = dedupeLines(
+		lines.filter((l) => !isBinaryNoise(l))
+	);
+
+	// score-based middle selection: what to keep from the unkept region
+	const scored: number[] = clean.map((l) => {
+		if (MIDDLE_KEEP_RE.test(l)) return 3;
+		if (PATH_RE.test(l)) return 2;
+		if (CMD_RE.test(l)) return 2;
+		if (STRUCTURED_RE.test(l)) return 1;
+		if (looksLikeBase64(l)) return -1;
+		return 0;
+	});
+
+	// index set: preserve order of head, middle, tail.
+	// Head (6) outranks tail (5) on purpose: the drop loop removes the
+	// lowest score first, and if head and tail tie they get dropped by
+	// insertion order — which would eat the head (the response's opening
+	// context) before the tail. Observed as a real failure: a structured
+	// JSON result lost its first lines while a repeated filler line that
+	// scored nothing survived to the end.
+	const keptIdx = new Map<number, number>(); // idx -> score
+	for (let i = 0; i < Math.min(HEAD_LINES, clean.length); i++) keptIdx.set(i, 6);
+	for (let i = Math.max(HEAD_LINES, clean.length - TAIL_LINES); i < clean.length; i++)
+		keptIdx.set(i, 5);
+
+	for (let i = HEAD_LINES; i < clean.length - TAIL_LINES; i++) {
+		if (scored[i] > 0) keptIdx.set(i, keptIdx.get(i) ?? scored[i]);
+	}
+
+	// if the kept set alone busts the budget, drop lowest-score first
+	let kept = [...keptIdx.keys()].sort((a, b) => a - b);
+	let text = () => kept.map((i) => clean[i]).join('\n');
+	const ellip = '\u2026';
+	while (kept.length > 1 && text().length + 40 > maxChars) {
+		// drop lowest scored, latest-inserted first so head/tail anchors survive:
+		// score order is middle (0..3) < tail (5) < head (6), so the head is
+		// dropped only when literally nothing else can be shed and one line
+		// must remain
+		const order = kept
+			.map((i, rank) => ({ i, rank, s: keptIdx.get(i) ?? 0 }))
+			.sort((a, b) => a.s - b.s || b.rank - a.rank);
+		// all-shown fallback prefers the LAST inserted line (highest rank, the
+		// tail end) over the head: order[0] is the newest because the sort
+		// already put ties in descending insertion order
+		const victim = order.find((o) => o.s < 6) ?? order[0];
+		kept = kept.filter((i) => i !== victim.i);
+	}
+
+	let body = text();
+	if (body.length > maxChars) body = body.slice(0, maxChars - 1) + ellip;
+
+	const accounted =
+		body.length + 40 <= maxChars
+			? `\n[distilled: ${kept.length} of ${clean.length} kept lines, ${raw.length} -> ${body.length} chars]`
+			: '';
+	return (body + accounted).trim() || '[no output]';
+}
+
+/**
+ * Map each role:'tool' message to the tool name its assistant caller
+ * executed, using the assistant's serialized toolCalls array.
+ *
+ * @param toolMessages   the tool-role messages in conversation order
+ * @param allMessages    the whole conversation (assistant messages carry toolCalls JSON)
+ */
+export function resolveToolNames(
+	toolMessages: { id: string; toolCallId?: string }[],
+	allMessages: { id: string; role: string; toolCalls?: string }[]
+): Map<string, string> {
+	const callsById = new Map<string, string>();
+	for (const m of allMessages) {
+		if (m.role !== 'assistant' || !m.toolCalls) continue;
+		try {
+			const parsed = JSON.parse(m.toolCalls) as {
+				id?: string;
+				function?: { name?: string };
+			}[];
+			if (Array.isArray(parsed)) {
+				for (const call of parsed) {
+					if (call?.id && call?.function?.name) callsById.set(call.id, call.function.name);
+				}
+			}
+		} catch {
+			// a corrupt toolCalls string must never break compaction
+		}
+	}
+
+	const names = new Map<string, string>();
+	for (const t of toolMessages) {
+		names.set(t.id, callsById.get(t.toolCallId ?? '') ?? 'tool');
+	}
+	return names;
+}
