diff --git a/tools/ui/src/lib/utils/agentic-loop-guard.ts b/tools/ui/src/lib/utils/agentic-loop-guard.ts
new file mode 100644
index 0000000000..8aacfb2dad
--- /dev/null
+++ b/tools/ui/src/lib/utils/agentic-loop-guard.ts
@@ -0,0 +1,180 @@
+/**
+ * Unproductive-loop detection for agentic flows.
+ *
+ * The bug this pins down, observed live on 2026-09-26: an agentic flow ran a
+ * `while (true)` turn loop whose only bound was `maxTurns` — and every
+ * "Continue" click reset that counter. A model that wedged into re-issuing
+ * the same tool calls grew the conversation by 3 messages per turn for 90
+ * minutes (~300 turns, 75 paid LLM calls) with nobody watching, and the only
+ * thing that ever stopped it was the user reloading the page.
+ *
+ * This module is the detection half of the fix. It is pure: it sees one
+ * completed turn at a time and decides whether the flow has stopped making
+ * progress. The agentic store owns the wiring (persist the turn, surface the
+ * verdict as the session's lastError, exit the loop).
+ *
+ * Two independent signals, both counted per flow invocation:
+ *
+ *  - identical tool calls: the same set of tool calls (same names, same
+ *    canonicalized arguments) issued AGENTIC_LOOP_REPEAT_LIMIT turns in a
+ *    row. One identical repeat is a legitimate retry; four is a wedge.
+ *  - silent tool spam: AGENTIC_SILENT_TURN_LIMIT consecutive tool-calling
+ *    turns with no visible reply text. Reading three files silently on the
+ *    way to an answer is fine; eight turns of nothing but tool calls with no
+ *    narration is not something a user meant to pay for.
+ */
+
+/** Canonical limit defaults; see agentic.constants.ts for rationale. */
+import { AGENTIC_LOOP_REPEAT_LIMIT, AGENTIC_SILENT_TURN_LIMIT } from '$lib/constants';
+
+/** Structural shape the guard needs; the loop's ApiChatCompletionToolCall
+ *  satisfies it, and tests can build plain objects. */
+export interface LoopGuardToolCall {
+	function: {
+		arguments?: string;
+		name: string;
+	};
+}
+
+export type LoopGuardStopReason = 'identical-calls' | 'silent-turns';
+
+export interface LoopGuardVerdict {
+	message: string;
+	reason: LoopGuardStopReason;
+}
+
+/** Sort object keys and re-stringify so `{a:1,b:2}` and `{b:2,a:1}` compare
+ *  equal; JSON key order is not part of a call's meaning. Falls back to the
+ *  raw string for non-JSON arguments (some models emit bare text there). */
+export function canonicalizeToolArguments(raw: string | undefined): string {
+	if (!raw) return '';
+
+	try {
+		const parsed: unknown = JSON.parse(raw);
+
+		if (parsed === null || typeof parsed !== 'object') return raw;
+
+		return JSON.stringify(sortObjectKeys(parsed as Record<string, unknown>));
+	} catch {
+		return raw;
+	}
+}
+
+function sortObjectKeys(value: Record<string, unknown>): Record<string, unknown> {
+	const result: Record<string, unknown> = {};
+
+	for (const key of Object.keys(value).sort()) {
+		const entry = value[key];
+
+		result[key] = entry && typeof entry === 'object' && !Array.isArray(entry)
+			? sortObjectKeys(entry as Record<string, unknown>)
+			: entry;
+	}
+
+	return result;
+}
+
+/** Order-independent signature of one turn's tool calls. An empty set of
+ *  calls yields null (the turn made no calls, nothing to repeat). */
+export function toolCallsSignature(calls: LoopGuardToolCall[]): string | null {
+	if (calls.length === 0) return null;
+
+	return calls
+		.map((call) => `${call.function.name}(${canonicalizeToolArguments(call.function.arguments)})`)
+		.sort()
+		.join('|');
+}
+
+/** Human-facing explanation for a stopped flow. The chat surfaces this as the
+ *  session error on the last assistant message, so it has to say what
+ *  happened and what to do next, not just that something stopped. */
+export function buildLoopStopMessage(
+	reason: LoopGuardStopReason,
+	detail: string,
+	limit: number
+): string {
+	if (reason === 'identical-calls') {
+		return `Stopped an endless tool loop: ${detail} was issued ${limit} turns in a row with the same arguments and nothing new happened. Reply below to take over — rephrase the task or tell the model what to do differently.`;
+	}
+
+	return `Stopped an unproductive agentic run: ${detail} tool-calling turns in a row produced no visible reply. Reply below to take over.`;
+}
+
+export class AgenticLoopGuard {
+	private lastSignature: string | null = null;
+	private repeatCount = 0;
+	private silentStreak = 0;
+
+	constructor(
+		private readonly repeatLimit: number = AGENTIC_LOOP_REPEAT_LIMIT,
+		private readonly silentLimit: number = AGENTIC_SILENT_TURN_LIMIT
+	) {}
+
+	/** Forget history. Used when the user explicitly extends the flow, so a
+	 *  verdict earned before the extension cannot re-trigger immediately. */
+	reset(): void {
+		this.lastSignature = null;
+		this.repeatCount = 0;
+		this.silentStreak = 0;
+	}
+
+	/** Record one completed turn. Returns a verdict when the flow should stop
+	 *  itself, null while it is still making (or at least changing) moves. */
+	recordTurn(content: string, toolCalls: LoopGuardToolCall[]): LoopGuardVerdict | null {
+		const signature = toolCallsSignature(toolCalls);
+
+		if (signature) {
+			if (signature === this.lastSignature) {
+				this.repeatCount++;
+
+				if (this.repeatCount + 1 >= this.repeatLimit) {
+					return {
+						message: buildLoopStopMessage(
+							'identical-calls',
+							`the same tool call${toolCalls.length > 1 ? 's' : ''} (${describeCalls(toolCalls)})`,
+							this.repeatLimit
+						),
+						reason: 'identical-calls'
+					};
+				}
+			} else {
+				this.lastSignature = signature;
+				this.repeatCount = 0;
+			}
+
+			// A turn the model spends narrating is a turn it used its own output:
+			// re-reading the same file after explaining why is a deliberate recheck,
+			// not a wedge. Only silent repeats accumulate toward the verdict.
+			if (content.trim()) this.repeatCount = 0;
+		} else {
+			this.lastSignature = null;
+			this.repeatCount = 0;
+		}
+
+		// A turn that carries tool calls but no user-visible text counts toward
+		// the silent streak; any turn with visible content resets it. Turns
+		// without tool calls end the flow before this ever matters.
+		if (toolCalls.length > 0 && !content.trim()) {
+			this.silentStreak++;
+
+			if (this.silentStreak >= this.silentLimit) {
+				return {
+					message: buildLoopStopMessage(
+						'silent-turns',
+						`${this.silentLimit} consecutive`,
+						this.silentLimit
+					),
+					reason: 'silent-turns'
+				};
+			}
+		} else {
+			this.silentStreak = 0;
+		}
+
+		return null;
+	}
+}
+
+function describeCalls(calls: LoopGuardToolCall[]): string {
+	return calls.map((call) => call.function.name).join(', ');
+}
