+	import type { Component } from 'svelte';
+
+	interface Props {
+		disabled?: boolean;
+	}
+
+	let { disabled = false }: Props = $props();
+
+	const MODE_ICONS: Record<PermissionMode, Component> = {
+		'accept-edits': Pencil,
+		auto: PlayCircle,
+		manual: Lock,
+		plan: Cog
