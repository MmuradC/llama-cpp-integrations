@@ -0,0 +1,162 @@
+/**
+ * permissionModeStore - Permission modes: one global default, per-chat overrides
+ *
+ * Owns the single mode the agentic loop's gates consult, plus per-conversation
+ * overrides. The global value is persisted on the panel backend (GET/POST
+ * /api/permission-mode) so it survives reloads and shares across browser tabs;
+ * it falls back to localStorage when the backend is unreachable (or on SSR).
+ *
+ * Per-chat overrides live with the panel (panel/frontend/chat-permission/),
+ * because that storage is the panel's own - see the chatModes field below.
+ */
+
+import { browser } from '$app/environment';
+import {
+	DEFAULT_PERMISSION_MODE,
+	PERMISSION_MODE_API,
+	PERMISSION_MODE_LOCALSTORAGE_KEY
+} from '$lib/constants/agentic.constants';
+import type { PermissionMode } from '$lib/types/agentic';
+
+class PermissionModeStore {
+	private _mode = $state<PermissionMode>(DEFAULT_PERMISSION_MODE);
+
+	/**
+	 * Per-conversation modes, keyed by conversation id.
+	 *
+	 * Populated and persisted by the panel (see
+	 * panel/frontend/chat-permission/store.svelte.ts), which owns that storage -
+	 * the app's own conversation schema is left alone. The gate consults this
+	 * with the id of the conversation a tool call belongs to, so one chat can be
+	 * Manual while another is Auto. A chat with no entry inherits the global
+	 * mode below, which is what makes the change opt-in: nothing shifts until a
+	 * chat is given a mode of its own.
+	 */
+	chatModes = $state<Record<string, PermissionMode>>({});
+
+	/** Installed by the panel, which is what stores a per-chat change. */
+	onChatModeChange: ((convId: string, mode: PermissionMode) => void) | null = null;
+
+	get mode(): PermissionMode {
+		return this._mode;
+	}
+
+	/** The mode for one conversation: its own if it has one, else the global one. */
+	getModeFor(convId?: string | null): PermissionMode {
+		return (convId && this.chatModes[convId]) || this._mode;
+	}
+
+	/**
+	 * Set the mode for one conversation. With no conversation yet - the
+	 * new-chat screen - it sets the global value instead, which is also what a
+	 * chat without an entry of its own inherits.
+	 */
+	setModeFor(convId: string | null | undefined, mode: PermissionMode): void {
+		if (!convId) {
+			this.setMode(mode);
+
+			return;
+		}
+
+		if (this.chatModes[convId] === mode) return;
+
+		this.chatModes = { ...this.chatModes, [convId]: mode };
+		this.onChatModeChange?.(convId, mode);
+	}
+
+	/** Replace the whole per-chat map, e.g. right after the panel loads it. */
+	replaceChatModes(modes: Record<string, PermissionMode>): void {
+		this.chatModes = { ...modes };
+	}
+
+	/**
+	 * Load the last used mode. Called by initStores() after migrations run:
+	 * prefers the panel backend value, falls back to localStorage, and falls
+	 * back to the default when neither has a valid entry.
+	 */
+	async initialize(): Promise<void> {
+		// browser-only network init: SSR runs with the default
+		if (!browser) return;
+
+		const remote = await this.fetchRemote();
+
+		if (remote) {
+			this._mode = remote;
+
+			return;
+		}
+
+		const local = this.loadLocal();
+
+		if (local) this._mode = local;
+	}
+
+	setMode(mode: PermissionMode): void {
+		this._mode = mode;
+
+		if (browser) {
+			try {
+				localStorage.setItem(PERMISSION_MODE_LOCALSTORAGE_KEY, mode);
+			} catch (err) {
+				console.error(`Failed to persist permission mode to local storage:`, err);
+			}
+
+			void this.pushRemote(mode);
+		}
+	}
+
+	private async fetchRemote(): Promise<PermissionMode | null> {
+		try {
+			const res = await fetch(PERMISSION_MODE_API, { signal: AbortSignal.timeout(6000) });
+
+			if (!res.ok) throw new Error(`status ${res.status}`);
+
+			const body = (await res.json()) as { mode: string };
+
+			return this.isValid(body?.mode) ? (body.mode as PermissionMode) : null;
+		} catch (err) {
+			// Silent: server may be a plain llama-server without the panel backend.
+			console.warn(`Failed to read permission mode from panel backend:`, err);
+
+			return null;
+		}
+	}
+
+	private isValid(value: unknown): boolean {
+		return (
+			typeof value === 'string' &&
+			(value === 'manual' || value === 'accept-edits' || value === 'auto' || value === 'plan')
+		);
+	}
+
+	private loadLocal(): PermissionMode | null {
+		try {
+			const stored = localStorage.getItem(PERMISSION_MODE_LOCALSTORAGE_KEY);
+
+			return this.isValid(stored) ? (stored as PermissionMode) : null;
+		} catch (err) {
+			console.error(`Failed to load permission mode from local storage:`, err);
+
+			return null;
+		}
+	}
+
+	private async pushRemote(mode: PermissionMode): Promise<void> {
+		try {
+			const res = await fetch(PERMISSION_MODE_API, {
+				body: JSON.stringify({ mode }),
+				headers: { 'Content-Type': 'application/json' },
+				method: 'POST',
+				signal: AbortSignal.timeout(6000)
+			});
+
+			if (!res.ok) throw new Error(`status ${res.status}`);
+		} catch (err) {
+			// Silent: the server may be a plain llama-server without the panel
+			// backend. Local storage already persisted the mode.
+			console.warn(`Failed to persist permission mode to panel backend:`, err);
+		}
+	}
+}
+
+export const permissionModeStore = new PermissionModeStore();
