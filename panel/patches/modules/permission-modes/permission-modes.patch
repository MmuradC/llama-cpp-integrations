+
+	const MODE_OPTIONS: PermissionMode[] = ['manual', 'accept-edits', 'auto', 'plan'];
+
+	const MODE_DESCRIPTIONS: Record<PermissionMode, string> = {
+		'accept-edits':
+			'Approve in-place edits to existing files. Ask before creating or overwriting a file, and before everything else.',
+		auto: 'Run all tools without asking.',
+		manual: 'Ask before every tool call.',
+		plan: 'Show the plan before running any tool call.'
+	};
+
+	let dropdownOpen = $state(false);
+
+	let confirmOpen = $state(false);
+	let pendingMode: PermissionMode | null = null;
+
+	/**
+	 * The mode of the conversation in front of the user, not a global one: each
+	 * chat carries its own (see the store's chatModes), and on the new-chat
+	 * screen there is no conversation yet, so the picker sets the value the next
+	 * chat will start with.
+	 */
+	const activeConvId = $derived(conversationsStore.activeConversation?.id ?? null);
+	const activeMode = $derived(permissionModeStore.getModeFor(activeConvId));
+
+	function handleModeClick(newMode: PermissionMode) {
+		dropdownOpen = false;
+
+		if (newMode === 'auto' && activeMode !== 'auto') {
+			// Auto runs tools without asking, so confirm the switch like Claude's
+			// auto-accept dialog does. Cancel keeps the current mode.
+			pendingMode = newMode;
+			confirmOpen = true;
+
+			return;
+		}
+
+		permissionModeStore.setModeFor(activeConvId, newMode);
+	}
+
+	function confirmAuto() {
+		if (pendingMode) permissionModeStore.setModeFor(activeConvId, pendingMode);
+
+		pendingMode = null;
+		confirmOpen = false;
+	}
+
+	function cancelAuto() {
+		pendingMode = null;
+		confirmOpen = false;
+	}
