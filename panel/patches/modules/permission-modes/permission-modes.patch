+
+						{PERMISSION_MODE_LABELS[optionMode]}
+					</span>
+
+					<span class="text-[11px] leading-tight text-muted-foreground">
+						{MODE_DESCRIPTIONS[optionMode]}
+
+						{#if isCurrent}
+							<span class="ml-1 font-medium">(current)</span>
+						{/if}
+					</span>
+				</DropdownMenu.Item>
+			{/each}
+		</DropdownMenu.Group>
+	</DropdownMenu.Content>
+</DropdownMenu.Root>
+
+<DialogConfirmation
+	bind:open={confirmOpen}
+	title="Switch to Auto?"
+	description="Auto lets the model run every tool call without asking — including shell commands. You can switch back at any time."
+	confirmText="Switch to Auto"
+	onConfirm={confirmAuto}
+	onCancel={cancelAuto}
+/>
