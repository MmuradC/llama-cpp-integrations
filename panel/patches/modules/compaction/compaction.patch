+import { COMPACTION_SUMMARY_PREFIX, DISPLAY_CHARS_PER_TOKEN_ESTIMATE } from '$lib/constants';
+
+/**
+ * Format a synthetic compaction-summary message. Same shape as
+ * formatCwdMessage in path-display.ts: a fixed prefix the UI parses back out
+ * to render a dedicated chip, with the model-facing text following it.
+ */
+export function formatCompactionMessage(summary: string): string {
+	return COMPACTION_SUMMARY_PREFIX + summary;
+}
+
+/**
+ * Parse a synthetic compaction message back into just the summary text.
+ * The caller must already know the message is synthetic (via the persisted
+ * `isSynthetic` flag); this only extracts the payload.
+ */
+export function parseCompactionMessage(content: string): string | null {
+	if (!content.startsWith(COMPACTION_SUMMARY_PREFIX)) return null;
+
+	return content.slice(COMPACTION_SUMMARY_PREFIX.length);
+}
+
+/**
+ * Turns a compaction message's stored char counts into the UI's "reduced
+ * from X to Y tokens" line. Token counts are estimated (see
+ * DISPLAY_CHARS_PER_TOKEN_ESTIMATE) since the actual tokenizer isn't
+ * available client-side - good enough for a rough sense of the win, not
+ * meant to be exact.
+ */
+export function formatCompactionStats(stats: {
+	originalChars: number;
+	summaryChars: number;
+}): string {
+	const before = Math.max(1, Math.round(stats.originalChars / DISPLAY_CHARS_PER_TOKEN_ESTIMATE));
+	const after = Math.max(1, Math.round(stats.summaryChars / DISPLAY_CHARS_PER_TOKEN_ESTIMATE));
+	const reduction = Math.round((1 - after / before) * 100);
+
+	return `~${before.toLocaleString()} → ~${after.toLocaleString()} tokens (${reduction}% smaller)`;
+}
