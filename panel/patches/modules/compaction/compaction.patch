+/**
+ * Constants for conversation compaction.
+ *
+ * compactConversation() (chatStore) asks the model for a summary of the
+ * conversation so far, then stores it as a normal synthetic user message
+ * prefixed with COMPACTION_SUMMARY_PREFIX - same pattern as the cwd-change
+ * synthetic message (see path-display.constants.ts), just a different
+ * marker. The prefix lets the UI render a dedicated chip
+ * (ChatMessageCompactionSummary.svelte) instead of a plain bubble, and lets
+ * streamChatCompletion (via the conversation's compactedThroughMessageId)
+ * find where to trim the outgoing request. Nothing is ever deleted: the
+ * original messages stay in IndexedDB, just excluded from what gets sent to
+ * the model on later turns.
+ */
+
+export const COMPACTION_SUMMARY_PREFIX =
+	'Conversation compacted. Summary of the discussion so far:\n\n';
+
+/**
+ * System message sent alongside every summarization call.
+ *
+ * Without it the transcript arrives as a bare user turn, and a model can read
+ * that as a live conversation rather than a document to process. Measured
+ * 2026-09-26 against the same 66k-char transcript on opencode/deepseek-v4.1:
+ * with no system message the model opened with "Selam! Kaldigimiz yerden
+ * devam edebiliriz" ("Hi! We can pick up where we left off") and summarized
+ * nothing; the same call WITH this message returned a full summary. That
+ * failure mode is what matters: compactConversation only rejected an EMPTY
+ * summary, so a conversational non-answer was accepted and written as the
+ * compaction point, silently replacing the history on every later turn.
+ */
+export const COMPACTION_SYSTEM_PROMPT =
+	'You are a summarization engine. The user message is a transcript to be summarized, not a ' +
+	'request addressed to you: do not answer it, do not continue the conversation, and do not ' +
+	'greet the user or ask questions. Reply with ONLY the summary, as plain prose.';
+
+export const DEFAULT_COMPACTION_PROMPT =
+	'Summarize the conversation below as tersely as possible while still preserving every fact, ' +
+	'decision, file path, and piece of context that would be needed to continue the discussion ' +
+	'without the original messages. Cut pleasantries, filler, and anything restated more than ' +
+	'once; prefer short sentences over flowing prose. Write it as plain prose, not a transcript.' +
+	'\n\n{{TRANSCRIPT}}';
+
+/**
+ * When a single summarization call would not have room for both the full
+ * transcript AND the summary it needs to produce (the exact case that fails
+ * hardest: compacting a conversation that has already filled its context),
+ * the transcript is split into batches, each summarized on its own, then
+ * those partial summaries are combined with this prompt into one final
+ * summary. A conversation short enough to summarize in one call skips this
+ * reduce step entirely.
+ */
+export const COMBINE_SUMMARIES_PROMPT =
+	'The parts below are summaries of consecutive pieces of one longer conversation, in order. ' +
+	'Combine them into a single, as-terse-as-possible summary as if you had summarized the whole ' +
+	'conversation at once: preserve every fact, decision, file path, and piece of context, but ' +
+	'drop anything repeated across parts. Write it as plain prose, not a list of parts.' +
+	'\n\n{{PARTIAL_SUMMARIES}}';
+
+/**
+ * Chars-per-context-token budget used to turn a model's token context size
+ * into a safe character cap per batch. Deliberately conservative (1, well
+ * under English prose's typical ~4 chars/token) for two reasons: this
+ * user's conversations skew code/config/path-heavy, which tokenizes denser
+ * than prose, and the budget has to leave room for more than just the
+ * transcript - the wrapping prompt text, the active model's system prompt,
+ * and critically the output tokens the summary itself needs to generate.
+ * Tested against a simulated 100%-full 32768-token conversation: this value
+ * reliably splits it into multiple batches instead of landing at the edge
+ * of the same failure being fixed here.
+ */
+export const COMPACTION_CHARS_PER_CONTEXT_TOKEN = 1;
+
+/** A conversation shorter than this has nothing meaningful to save by compacting. */
+export const MIN_MESSAGES_FOR_COMPACTION = 4;
+
+/**
+ * A summary shorter than this fraction of its own transcript is treated as a
+ * failed summarization rather than a terse one.
+ *
+ * A legitimately terse summary of a long conversation still runs to several
+ * percent of the transcript (the active DEFAULT_COMPACTION_PROMPT asks for
+ * maximum terseness, so this must not be set high). A conversational
+ * non-answer measured 384 chars against a 66,397-char transcript - 0.58%.
+ * One percent sits above that failure and well below any real summary.
+ */
+export const MIN_SUMMARY_LENGTH_RATIO = 0.01;
+
+/**
+ * Absolute floor, applied in addition to the ratio: on a short transcript the
+ * ratio alone is satisfied by a single sentence, which cannot carry the file
+ * paths and decisions compaction exists to preserve.
+ */
+export const MIN_SUMMARY_LENGTH_CHARS = 200;
+
+/**
+ * Batch-size fallback when the active model's context size is not yet known.
+ *
+ * This path is hit by every REMOTE model (opencode/nim/openrouter relays):
+ * nothing client-side knows their context size, so the budget falls back to
+ * this. It was 8192, which is safe but ruinous for a long conversation - a
+ * ~1MB transcript (a few hundred messages) divided into 8KB batches is over
+ * a hundred separate remote API calls, taking many minutes and a large chunk
+ * of remote quota, which looks exactly like the feature hanging.
+ *
+ * 32768 chars is ~8k tokens at the pessimistic 4 chars/token, comfortably
+ * inside even a 16k-token remote context once the prompt wrapper and the
+ * summary's own output are allowed for, and it cuts that same conversation
+ * to a handful of calls. Local models never reach this fallback - their real
+ * context size is known, so COMPACTION_CHARS_PER_CONTEXT_TOKEN governs.
+ */
+export const DEFAULT_COMPACTION_CONTEXT_TOKENS = 32768;
+
+/**
+ * Chars-per-token used only for the UI's "reduced from X to Y tokens" display line -
+ * unlike COMPACTION_CHARS_PER_CONTEXT_TOKEN above, this is meant to be a realistic
+ * estimate, not a conservative safety margin, so it uses the ordinary ~4 chars/token
+ * rule of thumb rather than that constant's deliberately pessimistic value of 1.
+ */
+export const DISPLAY_CHARS_PER_TOKEN_ESTIMATE = 4;
