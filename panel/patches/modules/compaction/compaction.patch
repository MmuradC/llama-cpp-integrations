+<script lang="ts">
+	import { ChevronDown, PackageCheck } from '@lucide/svelte';
+	import * as Collapsible from '$lib/components/ui/collapsible';
+	import type { DatabaseMessage } from '$lib/types';
+	import { formatCompactionStats, parseCompactionMessage } from '$lib/utils';
+
+	interface Props {
+		class?: string;
+		message: DatabaseMessage;
+	}
+
+	let { class: className = '', message }: Props = $props();
+
+	// Parse the synthetic message content in the UI so the row reuses the
+	// exact same summary text the model sees on later turns.
+	let summary = $derived(parseCompactionMessage(message.content));
+	// Only present on messages compacted after this feature shipped - older
+	// compaction messages just don't show the line, nothing to backfill.
+	let statsLabel = $derived(
+		message.compactionStats ? formatCompactionStats(message.compactionStats) : null
+	);
+	let isOpen = $state(false);
+</script>
+
+{#if summary !== null}
+	<Collapsible.Root bind:open={isOpen} class="py-1.5 {className}">
+		<Collapsible.Trigger
+			class="flex items-center gap-2 text-muted-foreground hover:text-foreground"
+		>
+			<PackageCheck class="text-muted-foreground/60 h-3.5 w-3.5 shrink-0" />
+
+			<span class="text-foreground/80 text-sm font-medium">Conversation compacted</span>
+
+			<ChevronDown
+				class={'h-3.5 w-3.5 shrink-0 transition-transform' + (isOpen ? ' rotate-180' : '')}
+			/>
+		</Collapsible.Trigger>
+
+		{#if statsLabel}
+			<p class="text-muted-foreground/60 ml-5.5 text-xs">{statsLabel}</p>
+		{/if}
+
+		<Collapsible.Content class="mt-1.5 ml-5.5 text-sm whitespace-pre-wrap text-muted-foreground">
+			{summary}
+		</Collapsible.Content>
+	</Collapsible.Root>
+{/if}
