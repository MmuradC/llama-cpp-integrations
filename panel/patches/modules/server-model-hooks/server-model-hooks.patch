+// Loads one provider's pinned-models file into name -> empty-preset pairs
+// (registered id = "<provider>/<sanitized real id>"). The preset is
+// deliberately empty: these models are never spawned (see the
+// SERVER_MODEL_SOURCE_REMOTE handling in load_models()), so there are no
+// CLI args to render — the name alone (and the fixed port assigned later)
+// is all proxy_request() needs to forward chat requests to the panel
+// backend, which dispatches to the right upstream API by provider prefix.
+static common_presets load_remote_model_presets_for(const std::string & provider, const std::string & filename) {
+    common_presets result;
+    std::ifstream f(filename);
+    if (!f.is_open()) {
+        return result; // no pins yet, not an error
+    }
+    try {
+        std::stringstream buffer;
+        buffer << f.rdbuf();
+        json data = json::parse(buffer.str());
+        if (!data.is_array()) {
+            return result;
+        }
+        for (const auto & entry : data) {
+            if (!entry.is_object()) {
+                continue;
+            }
+            std::string id = entry.value("id", std::string());
+            if (id.empty()) {
+                continue;
+            }
+            // llama.cpp's own normalizeModelName() (tools/ui/src/lib/utils/
+            // model-names.ts) only preserves an id with EXACTLY one slash
+            // when it persists which model produced a reply; two or more
+            // collapses to just the last segment, silently losing the
+            // provider prefix and making the id unresolvable on the next
+            // message in that conversation. Real provider ids (vendor/model)
+            // have their own inner slash, so every "/" here becomes "__",
+            // leaving exactly one real slash overall. Must match
+            // panel/backend/server.py's _registered_id() exactly.
+            std::string sanitized = id;
+            size_t pos = 0;
+            while ((pos = sanitized.find('/', pos)) != std::string::npos) {
+                sanitized.replace(pos, 1, "__");
+                pos += 2;
+            }
+            result[provider + "/" + sanitized] = common_preset{};
+        }
+    } catch (const std::exception & e) {
+        SRV_WRN("failed to parse %s: %s\n", filename.c_str(), e.what());
+    }
+    return result;
