+export function annotateCodeSaveTargets(children: unknown[]): void {
+	for (let i = 0; i < children.length - 1; i++) {
+		const node = children[i] as MdastCodeNode;
+
+		if (node.type !== 'code') continue;
+
+		const next = children[i + 1] as MdastParagraphNode;
+
+		if (next.type !== 'paragraph' || !Array.isArray(next.children)) continue;
