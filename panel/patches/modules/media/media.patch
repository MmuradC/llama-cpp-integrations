+import { FileTypeCategory } from '$lib/enums';
+import { filterFilesByModalities, getFileTypeCategory, isFileTypeSupported } from '$lib/utils';
 import { processFilesToChatUploaded } from '$lib/utils/browser-only';
+import { PANEL_ORIGIN } from '@mcp-panel/panel-origin';
+
+// The panel backend (see panel/backend/server.py, upload_image()) - a separate
+// process from the router, not proxied through it. It writes the upload to
+// disk and answers with the path. The origin is derived from the page, not
+// hardcoded: pasting an image from a phone must reach sn1p, not the phone.
+const IMAGE_UPLOAD_URL = `${PANEL_ORIGIN}/api/upload-image`;
+
+/**
+ * Save a pasted/dropped image that the active model cannot see inline.
+ *
+ * The path is what makes the image reachable at all: llama.cpp offers its own
+ * read_media tool only to models that can see, so for a text-only model a
+ * vision-capable MCP tool (vision_inspect / vision_ocr) is the way in, and it
+ * needs a file on disk. The path is returned so it can travel on the
+ * attachment itself (ChatUploadedFile.savedPath) and be handed to the model as
+ * text at request time - the user sees the preview, not a path in their
+ * message, and the model still gets its route to the image.
+ *
+ * Failures are swallowed on purpose: if the panel backend is down, the image
+ * simply has no saved path, exactly as before this existed.
+ */
+async function saveImageForPathInsertion(file: File): Promise<string | null> {
+	const body = new FormData();
+
+	body.set('file', file);
+
+	try {
+		const res = await fetch(IMAGE_UPLOAD_URL, { body, method: 'POST' });
+
+		if (!res.ok) return null;
+
+		const { path } = (await res.json()) as { path?: string };
+
+		return path ?? null;
+	} catch {
+		// panel backend unreachable - the image just stays unattached, no crash
+		return null;
+	}
+}
 
