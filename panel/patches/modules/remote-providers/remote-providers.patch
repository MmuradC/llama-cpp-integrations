diff --git a/tools/ui/src/routes/nim/+page.svelte b/tools/ui/src/routes/nim/+page.svelte
new file mode 100644
index 0000000000..bdb4f7bf1e
--- /dev/null
+++ b/tools/ui/src/routes/nim/+page.svelte
@@ -0,0 +1,13 @@
+<script lang="ts">
+	// NVIDIA NIM model browser: pinned models for the NIM provider.
+	//
+	// The page itself lives outside this tree (panel/frontend/NimPage.svelte,
+	// reached through the @mcp-panel alias) so a llama.cpp version bump cannot
+	// take it away; this file exists only so SvelteKit's router can discover the
+	// page at all — the same reason upstream ships the settings and mcp-servers
+	// route files. Without it, RightBar's `#/nim` link changes the hash and
+	// renders nothing.
+	import NimPage from '@mcp-panel/NimPage.svelte';
+</script>
+
+<NimPage />
