index 0000000000..94bc82a5a2
--- /dev/null
+++ b/tools/ui/src/lib/utils/panel-command-runtime.ts
@@ -0,0 +1,56 @@
+/**
+ * The npm-packaged pieces the panel's own UI needs, re-exported for it.
+ *
+ * Started as the slash commands' imports; the Projects UI needs the same kind
+ * of thing, so this is now the panel's single import surface for node_modules.
+ *
+ * panel/frontend lives outside the tools/ui tree (see
+ * panel/patches/README.md), and a
+ * bare package specifier in a file there resolves node_modules relative to
+ * that file's own path — which never reaches tools/ui/node_modules. Importing
+ * `@lucide/svelte` or `svelte-sonner` directly from panel/frontend therefore
+ * fails at build time with a vite:load-fallback error. RightBar.svelte works
+ * around the same constraint by taking its icons as props from in-tree code;
+ * the panel's UI needs a whole set of them plus the toast helper, so they are
+ * funnelled through this shim instead — panel/frontend/chat-commands/index.ts
+ * and panel/frontend/projects/* import from here via `$lib`, which is a global
+ * alias and resolves the same way for any importer.
+ *
+ * Deliberately NOT exported through the `$lib/utils` barrel: panel-ui.patch
+ * already touches lib/utils/index.ts, and keeping this file out of it means
+ * no two patches ever edit the same file.
+ *
+ * Only the icons the panel actually uses are listed — a wildcard re-export
+ * would defeat the point by pulling the whole icon set into the panel chunk.
+ */
+
+export {
+	Activity,
+	Check,
+	ChevronRight,
+	CircleQuestionMark,
+	Copy,
+	Download,
+	EyeOff,
+	Folder,
+	FolderPlus,
+	Gauge,
+	GitBranch,
+	History,
+	MemoryStick,
+	PackageOpen,
+	Palette,
+	Pencil,
+	PencilLine,
+	Plug,
+	Plus,
+	Receipt,
+	Scissors,
+	Settings,
+	ShieldCheck,
+	Square,
+	SquarePen,
+	Trash2,
+	X
+} from '@lucide/svelte';
+export { toast } from 'svelte-sonner';
