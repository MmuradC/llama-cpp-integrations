diff --git a/tools/ui/src/lib/stores/keyboard-inset.svelte.ts b/tools/ui/src/lib/stores/keyboard-inset.svelte.ts
new file mode 100644
index 0000000000..af58b64c17
--- /dev/null
+++ b/tools/ui/src/lib/stores/keyboard-inset.svelte.ts
@@ -0,0 +1,68 @@
+/**
+ * keyboardInsetStore - the on-screen keyboard's height, as the layout needs it
+ *
+ * Why this exists: the composer is anchored to the bottom of the viewport. On
+ * iOS the keyboard *overlays* the page - Safari ignores
+ * `interactive-widget=resizes-content`, which the app's own viewport meta
+ * requests (see app.html) - so the composer and its Send button end up behind
+ * the keyboard, where a finger cannot reach them. That is the "can't send from
+ * my phone" failure: on Android/Chrome the layout viewport genuinely shrinks
+ * and everything keeps working, on iOS nothing does unless the app insets
+ * itself. Nothing in this tree tracked the keyboard at all before this.
+ *
+ * The measurement uses `visualViewport`, the only API that reports the
+ * keyboard: `innerHeight - visualViewport.height` is how much of the page the
+ * keyboard is covering. Three details that matter:
+ *
+ *   - `offsetTop` is included because iOS scrolls the visual viewport up when
+ *     focusing a field near the bottom; without it the inset is understated by
+ *     exactly the scroll amount, which is the case that prompted this.
+ *   - the value is only non-zero above a threshold, because Safari reports a
+ *     few pixels of difference for its own toolbars, and insetting by that
+ *     would shift the composer for no reason.
+ *   - it listens to `resize` and `scroll` on the visual viewport *and* to
+ *     window orientation changes: iOS fires them in a different order
+ *     depending on how the keyboard was opened (tap vs programmatic focus).
+ */
+
+import { browser } from '$app/environment';
+
+/** Below this the difference is Safari's own chrome, not a keyboard. */
+const MIN_KEYBOARD_PX = 80;
+
+class KeyboardInsetStore {
+	/** Height in CSS pixels the keyboard covers at the bottom of the viewport. */
+	inset = $state(0);
+
+	/** True while a keyboard is actually up, for callers that only need the flag. */
+	get isOpen(): boolean {
+		return this.inset > 0;
+	}
+
+	/** Start tracking. Safe to call twice; called once from the app layout. */
+	watch(): () => void {
+		if (!browser || !window.visualViewport) return () => {};
+
+		const viewport = window.visualViewport;
+
+		const measure = () => {
+			const covered = window.innerHeight - viewport.height - viewport.offsetTop;
+
+			this.inset = covered > MIN_KEYBOARD_PX ? Math.round(covered) : 0;
+		};
+
+		measure();
+
+		viewport.addEventListener('resize', measure);
+		viewport.addEventListener('scroll', measure);
+		window.addEventListener('orientationchange', measure);
+
+		return () => {
+			viewport.removeEventListener('resize', measure);
+			viewport.removeEventListener('scroll', measure);
+			window.removeEventListener('orientationchange', measure);
+		};
+	}
+}
+
+export const keyboardInsetStore = new KeyboardInsetStore();
