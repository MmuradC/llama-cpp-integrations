+++ b/tools/ui/src/lib/components/app/chat/ChatForm/ChatFormContextGauge/OpenCodeUsageDial.svelte
@@ -0,0 +1,98 @@
+<script lang="ts">
+	// Deliberately its own component, NOT folded into ChatFormContextGauge.svelte:
+	// that one is only rendered by ChatFormActions.svelte behind
+	// {#if hasProcessedTokens}, which checks for llama.cpp-specific
+	// `timings` on assistant messages (see hasProcessedTokens in
+	// ChatFormActions.svelte). A pinned remote model (OpenRouter/NIM/OpenCode)
+	// never gets a `timings` object — the relay just forwards the provider's
+	// own OpenAI-shaped chunks (panel/backend/server.py's remote_chat_completions)
+	// — so that condition is permanently false for this conversation and the
+	// whole gauge area, dial included, never mounted. This component has its
+	// own always-evaluated guard (openCodeModelId) instead, so it shows up
+	// regardless of whether any local-model token stats exist.
+	//
+	// Reuses the same trigger classes/handlers and data-context-gauge-trigger
+	// attribute as ChatFormContextGauge's own dial so a click/hover here
+	// opens the exact same shared popup (ContextGaugePopup.svelte, which is
+	// unconditionally mounted from ChatForm.svelte and already renders this
+	// same usage estimate as text+bar) at the correct position relative to
+	// THIS element.
+	import { colorLevelFromPercent } from './context-gauge';
+	import ContextGaugeDial from './ContextGaugeDial.svelte';
+	import {
+		gaugeTriggerClick,
+		gaugeTriggerEnter,
+		gaugeTriggerKeydown,
+		gaugeTriggerLeave,
+		gaugeTriggerPointerDown
+	} from './gauge-popup.svelte';
+	import { useContextGauge } from '$lib/hooks/use-context-gauge.svelte';
+	import { onDestroy } from 'svelte';
+
+	const gauge = useContextGauge();
+
+	const openCodeModelId = $derived(
+		gauge.activeModelId?.startsWith('opencode/') ? gauge.activeModelId : null
+	);
+	let openCodePercent = $state<number | null>(null);
+	let pollHandle: ReturnType<typeof setInterval> | null = null;
+
+	async function pollUsage(modelId: string) {
+		try {
+			const res = await fetch(
+				`http://127.0.0.1:9010/api/opencode/usage?model=${encodeURIComponent(modelId)}`,
+				{ signal: AbortSignal.timeout(6000) }
+			);
+
+			if (!res.ok) throw new Error(`HTTP ${res.status}`);
+
+			const body = await res.json();
+
+			openCodePercent =
+				typeof body.limit_5h === 'number' && body.limit_5h > 0
+					? Math.min(100, Math.round((body.count_5h / body.limit_5h) * 100))
+					: null;
+		} catch {
+			// dial just shows an empty ring until the next successful poll
+		}
+	}
+
+	$effect(() => {
+		const modelId = openCodeModelId;
+
+		if (pollHandle !== null) {
+			clearInterval(pollHandle);
+			pollHandle = null;
+		}
+
+		if (!modelId) {
+			openCodePercent = null;
+
+			return;
+		}
+
+		void pollUsage(modelId);
+		pollHandle = setInterval(() => void pollUsage(modelId), 20000);
+	});
+
+	onDestroy(() => {
+		if (pollHandle !== null) clearInterval(pollHandle);
+	});
+</script>
+
+{#if openCodeModelId}
+	<div
+		aria-label="OpenCode Go usage (~5h window, local estimate)"
+		class="flex h-5 w-5 cursor-default items-center justify-center"
+		data-context-gauge-trigger
+		onclick={gaugeTriggerClick}
+		onkeydown={gaugeTriggerKeydown}
+		onpointerdown={gaugeTriggerPointerDown}
+		onpointerenter={gaugeTriggerEnter}
+		onpointerleave={gaugeTriggerLeave}
+		role="button"
+		tabindex="0"
+	>
+		<ContextGaugeDial level={colorLevelFromPercent(openCodePercent)} percent={openCodePercent} />
+	</div>
+{/if}
