+/**
+ * pendingImagePathStore - Bridges the file-upload hook to the message input
+ *
+ * An image pasted/dropped while the active model has no vision support gets
+ * saved to disk instead of attached (see use-chat-screen-file-upload), so a
+ * text-only model can still reach it through a filesystem-reading tool. The
+ * hook (owned by ChatScreen) and the message textarea (owned by ChatForm)
+ * have no direct line to each other, so the resulting path travels through
+ * this small shared store rather than threading a new callback prop through
+ * the components in between.
+ */
+
+class PendingImagePathStore {
+	private _path = $state('');
+
+	get path(): string {
+		return this._path;
+	}
+
+	push(path: string): void {
+		this._path = this._path ? `${this._path} ${path}` : path;
+	}
+
+	consume(): string {
+		const path = this._path;
+
+		this._path = '';
+
+		return path;
+	}
+}
+
+export const pendingImagePathStore = new PendingImagePathStore();
